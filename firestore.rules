rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // Can see the ledger (keep in sync with config.js → allowedEmails)
    function isFamily() { return signedIn() && email() in ['jhv2508@gmail.com', 'priyalparekh2000@gmail.com']; }
    // Can add, edit and delete (keep in sync with config.js → editors)
    function isEditor() { return signedIn() && email() in ['jhv2508@gmail.com']; }

    match /weddings/{weddingId}/{collection}/{docId} {
      allow read: if isFamily() && collection in ['people', 'expenses', 'payments'];
      allow write: if isEditor() && collection in ['people', 'expenses', 'payments'];
    }
  }
}
